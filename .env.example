# Local app defaults.
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/reviewer.db
# OpenAI (server only). Add your key to .env, never to this example or Git.
OPENAI_API_KEY=
# App default for new requests; users may choose an OpenAI model in the UI.
# Blank also uses this default. Restart the API after changing .env.
OPENAI_MODEL=gpt-4.1-mini
REVIEW_TIMEOUT_SECONDS=60
