{
  "name": "code-snippet-reviewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "uv run --locked python -m backend --reload",
    "dev:web": "vite --host 127.0.0.1",
    "db:migrate": "uv run --locked python -m backend.database",
    "typecheck": "tsc --noEmit",
    "test": "uv run --locked pytest",
    "build": "npm run typecheck && vite build",
    "start": "uv run --locked python -m backend --serve-client",
    "check": "npm run build && npm test",
    "setup": "npm ci && uv sync --locked",
    "api:types": "uv run --locked python -m backend.export_openapi && openapi-typescript work/openapi.json -o src/shared/api-types.ts && prettier --write src/shared/api-types.ts",
    "format": "prettier --write src vite.config.ts playwright.config.ts tests/browser",
    "test:e2e": "npm run build && playwright test",
    "eval:review": "uv run --locked python -m evals.run",
    "trace:calls": "uv run --locked python -m backend.tracing"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
